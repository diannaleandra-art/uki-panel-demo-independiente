{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/qa-panel/:file",
      "destination": "/api/qa-panel?file=:file"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://uki-panel-f4909.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://uki-panel-f4909.firebaseapp.com/__/firebase/init.json"
    }
  ],
  "headers": [
    {
      "source": "/uki-factura-interfaz-live.mjs",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://diannaleandra-art.github.io"
        }
      ]
    },
    {
      "source": "/uki-factura-lectura-live.mjs",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://diannaleandra-art.github.io"
        }
      ]
    }
  ],
  "functions": {
    "api/qa-panel.js": {
      "includeFiles": "{firebase/**,qa-sources/**}"
    }
  }
}
